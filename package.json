{
  "name": "cricscore-workspace",
  "private": true,
  "version": "2.8.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --prefix apps/frontend",
    "build": "npm run build --prefix apps/frontend",
    "preview": "npm run preview --prefix apps/frontend",
    "lint": "npm run lint --prefix apps/frontend",
    "test": "npm run test --prefix apps/frontend",
    "test:all": "npm run test --prefix apps/frontend && npm run test --prefix apps/backend && npm run test:ai",
    "test:e2e": "npm test --prefix apps/e2e",
    "test:e2e:dev": "BASE_URL=https://cricscoredev.venkateshsingamsetty.com API_URL=https://api.cricscoredev.venkateshsingamsetty.com npm test --prefix apps/e2e",
    "test:e2e:dev:headed": "BASE_URL=https://cricscoredev.venkateshsingamsetty.com API_URL=https://api.cricscoredev.venkateshsingamsetty.com npm test --prefix apps/e2e -- --headed",
    "test:e2e:sync:headed": "BASE_URL=https://cricscoredev.venkateshsingamsetty.com API_URL=https://api.cricscoredev.venkateshsingamsetty.com npm test --prefix apps/e2e -- tests/multi-browser-live-sync.spec.ts --headed",
    "test:e2e:journey:headed": "BASE_URL=https://cricscoredev.venkateshsingamsetty.com API_URL=https://api.cricscoredev.venkateshsingamsetty.com npm test --prefix apps/e2e -- tests/user-journey.spec.ts --headed",
    "test:ai": "node evals/run_ai_chat_eval.js",
    "deps:check": "npm outdated; for d in apps/backend/lambdas/*; do if [ -f \"$d/package.json\" ]; then (cd \"$d\" && npm outdated 2>/dev/null); fi; done",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "minimatch": {
      "brace-expansion": "^1.1.21"
    },
    "brace-expansion": "^5.0.12"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
