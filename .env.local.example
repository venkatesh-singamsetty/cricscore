# ------------------------------------------------------------------------------
# CricScore Local Infrastructure Configuration Template
# Copy this file to `.env.local` and replace the dummy values with your actual config.
# WARNING: Do NOT commit `.env.local` to version control.
# ------------------------------------------------------------------------------

# ==============================================================================
# SECTION A: USER CONFIGURATION (YOU MUST FILL THESE OUT)
# ==============================================================================

# --------------------
# 1) AWS Credentials & Config
# Use an IAM user's access key (AWS Console > IAM > Users > Security credentials > Create access key). Do not use root.
# Leave the two keys blank if already set via `aws configure` or exported in your shell profile.
# --------------------
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_REGION='us-east-1'
AWS_DEFAULT_REGION='us-east-1'

# Optional. S3 bucket for Terraform state (created by --bootstrap-only).
# Default: <PROJECT_NAME>-tfstate-<your AWS account ID>
# TF_STATE_BUCKET='my-unique-bucket-name'

# --------------------
# 2) Database (SENSITIVE)
# Create a PostgreSQL service at https://console.aiven.io/signup and copy its Service URI.
# Optional but recommended for strict SSL: Download your Project Root CA cert from Aiven Console
# and save it to `infra/database/certs/aiven-ca.pem`.
# --------------------
TF_DATABASE_URL='postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require'

# --------------------
# 3) Email Configuration
# --------------------
TF_SES_SOURCE_EMAIL='noreply@yourdomain.com'
ADMIN_EMAIL='you@youremail.com'

# --------------------
# 4) Project & Domain Configuration
# Update these to match YOUR domain and base project name.
# IMPORTANT: Use base names here (e.g. 'cricscore', NOT 'cricscoredev').
# The deployment script automatically appends 'dev' for dev environments:
#   - Dev:  cricscoredev.yourdomain.com (Project / Prefix: cricscoredev)
#   - Prod: cricscore.yourdomain.com    (Project / Prefix: cricscore)
# --------------------
DOMAIN_NAME='cricscore.yourdomain.com'
ZONE_DOMAIN='yourdomain.com'
SUBDOMAIN_PREFIX='cricscore'
PROJECT_NAME='cricscore'
#
# Optional overrides: only set these if you need a non-standard naming scheme:
# DEV_DOMAIN_NAME='cricscoredev.yourdomain.com'
# DEV_SUBDOMAIN_PREFIX='cricscoredev'
# DEV_PROJECT_NAME='cricscoredev'
# PROD_DOMAIN_NAME='cricscore.yourdomain.com'
# PROD_SUBDOMAIN_PREFIX='cricscore'
# PROD_PROJECT_NAME='cricscore'

# --------------------
# 5) AI / LLM Configuration
# OpenAI is required: it powers chat and the embeddings (rulebook PDF search).
# Get a key at https://platform.openai.com/api-keys
# --------------------
OPENAI_API_KEY='your-openai-api-key-here'
# Optional (these are the defaults, so you can leave them out):
# LLM_BASE_URL='https://api.openai.com/v1'
# LLM_MODEL='gpt-4o-mini'

# --------------------
# 6) GitHub Issue Agent (MCP) Configuration (OPTIONAL)
# Allows the AI Chat Assistant to raise GitHub issues via MCP (`create_github_issue`).
# Note: The Cricket Match Weather Agent (`get_match_weather`) uses Open-Meteo ($0, no key needed).
# See docs/github_issue_agent.md and docs/weather_report_agent.md for details.
# --------------------
# GITHUB_TOKEN='ghp_your-github-pat-with-issues-write-scope'
# GITHUB_REPO='venkatesh-singamsetty/cricscore'


# ==============================================================================
# SECTION B: AUTO-GENERATED CONFIGURATION (DO NOT MODIFY)
# ==============================================================================
# The deployment scripts will automatically populate these variables.
# Leave them blank.
# ------------------------------------------------------------------------------

S3_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
