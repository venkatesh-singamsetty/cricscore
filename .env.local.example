# ------------------------------------------------------------------------------
# CricScore Local Infrastructure Configuration Template
# Copy this file to `.env.local` and replace the dummy values with your actual config.
# WARNING: Do NOT commit `.env.local` to version control.
# ------------------------------------------------------------------------------

# ==============================================================================
# SECTION A: USER CONFIGURATION (YOU MUST FILL THESE OUT)
# ==============================================================================

# --------------------
# 1) AWS Credentials & Config
# (You can leave the credentials blank if you already have them exported in your shell profile (e.g., ~/.zshrc, ~/.bash_profile) or AWS CLI config)
# --------------------
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_REGION='us-east-1'
AWS_DEFAULT_REGION='us-east-1'

# Globally unique S3 bucket for Terraform state (created by --bootstrap-only).
TF_STATE_BUCKET='yourname-cricscore-terraform-state'

# --------------------
# 2) Database (SENSITIVE)
# --------------------
TF_DATABASE_URL='postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require'

# --------------------
# 3) Email Configuration
# --------------------
TF_SES_SOURCE_EMAIL='noreply@yourdomain.com'
ADMIN_EMAIL='you@youremail.com'

# --------------------
# 4) Project & Domain Configuration
# Update these to match YOUR domain and project name
# --------------------
DOMAIN_NAME='cricscore.yourdomain.com'
ZONE_DOMAIN='yourdomain.com'
SUBDOMAIN_PREFIX='cricscore'
PROJECT_NAME='cricscore'
# Dev defaults to cricscoredev.yourdomain.com / cricscoredev.
# Set these only if you want a different dev naming pattern.
# DEV_DOMAIN_NAME='cricscoredev.yourdomain.com'
# DEV_SUBDOMAIN_PREFIX='cricscoredev'
# DEV_PROJECT_NAME='cricscoredev'
# Optional production overrides: PROD_DOMAIN_NAME, PROD_SUBDOMAIN_PREFIX, PROD_PROJECT_NAME.

# --------------------
# 5) AI / LLM Configuration
# Option A (default): OpenAI. Get a key at https://platform.openai.com
# --------------------
OPENAI_API_KEY='your-openai-api-key-here'

# Option B (free chat): Google Gemini. Get a key at https://aistudio.google.com/apikey
# Leave OPENAI_API_KEY blank/removed (it takes priority if set), then uncomment:
# LLM_API_KEY='your-google-ai-studio-key'
# LLM_BASE_URL='https://generativelanguage.googleapis.com/v1beta/openai/'
# LLM_MODEL='gemini-2.0-flash'
# Note: cricket-rules search uses OpenAI's text-embedding-3-small, which Gemini
# does not offer, so that feature needs an OpenAI key.

# Option C: another OpenAI-compatible proxy (e.g. OpenRouter) for chat.
# OpenAI is still required for text-embedding-3-small vector generation.
# LLM_API_KEY='your-openrouter-api-key-here'
# LLM_BASE_URL='https://openrouter.ai/api/v1'


# ==============================================================================
# SECTION B: AUTO-GENERATED CONFIGURATION (DO NOT MODIFY)
# ==============================================================================
# The deployment scripts will automatically populate these variables.
# Leave them blank.
# ------------------------------------------------------------------------------

S3_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
