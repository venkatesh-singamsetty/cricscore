#!/usr/bin/env sh

echo "📄 Auto-generating Central Platform Dashboard..."
bash infra/scripts/generate_platform_dashboard.sh
git add docs/platform_dashboard.md docs/aws_resources_dashboard.md

echo "💅 Formatting code..."
npx lint-staged

echo "🔒 Scanning for secrets in staged files before committing..."
if command -v gitleaks &> /dev/null; then
  # Run gitleaks to check for secrets in files about to be committed
  gitleaks protect -v --staged
else
  echo "⚠️  gitleaks is not installed. Skipping secrets scan."
  echo "Run ./infra/scripts/setup.sh to install it."
fi
