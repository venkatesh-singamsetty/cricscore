#!/usr/bin/env sh

if [ -n "$SKIP_VALIDATE" ] || [ -n "$SKIP_PRE_PUSH" ]; then
  echo "⏭️  Skipping pre-push validation (SKIP_PRE_PUSH/SKIP_VALIDATE set)."
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
RECEIPT_FILE="$REPO_ROOT/.git/.local_validation_receipt"

# Enforce branch is up-to-date with origin/main before pushing so PRs never have merge conflicts
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
if [ "$CURRENT_BRANCH" != "main" ] && [ -n "$CURRENT_BRANCH" ]; then
  git fetch origin main --quiet 2>/dev/null || true
  if git rev-parse --verify origin/main >/dev/null 2>&1; then
    if ! git merge-base --is-ancestor origin/main HEAD; then
      echo "❌ Branch '$CURRENT_BRANCH' is behind 'origin/main' (e.g. a PR or Semantic Release commit landed on main)."
      echo "👉 Run: git fetch origin main && git merge origin/main --no-edit"
      exit 1
    fi
  fi
fi

# Proactive Dependabot Check: Ensure any open Dependabot PRs are consolidated into the branch before pushing
if command -v gh >/dev/null 2>&1 && [ "$CURRENT_BRANCH" != "main" ] && [ -n "$CURRENT_BRANCH" ]; then
  BOT_PRS_JSON="$(gh pr list --repo "venkatesh-singamsetty/cricscore" --author "app/dependabot" --state open --json number,title,headRefOid 2>/dev/null || echo "[]")"
  UNMERGED_COUNT=0
  for row in $(echo "$BOT_PRS_JSON" | jq -r '.[] | @base64' 2>/dev/null || true); do
    _jq() { echo "$row" | base64 --decode | jq -r "$1"; }
    NUM=$(_jq '.number')
    SHA=$(_jq '.headRefOid')
    if ! git merge-base --is-ancestor "$SHA" HEAD 2>/dev/null; then
      UNMERGED_COUNT=$((UNMERGED_COUNT + 1))
    fi
  done

  if [ "$UNMERGED_COUNT" -gt 0 ]; then
    echo "📦 [Dependabot Guard] Detected $UNMERGED_COUNT open Dependabot PR(s) not yet merged into '$CURRENT_BRANCH'."
    echo "🔄 Automatically consolidating Dependabot PRs into local branch..."
    if "$REPO_ROOT/infra/scripts/consolidate_dependabot_prs.sh" --merge; then
      echo "✅ Successfully consolidated open Dependabot PR(s) into '$CURRENT_BRANCH'."
      echo "👉 Please run 'git push' again to publish the consolidated commits to GitHub."
      exit 1
    else
      echo "❌ Failed to automatically merge Dependabot PR(s). Please resolve conflicts and retry."
      exit 1
    fi
  fi
fi

HASH_CMD=""
if command -v sha256sum >/dev/null 2>&1; then
  HASH_CMD="sha256sum"
elif command -v shasum >/dev/null 2>&1; then
  HASH_CMD="shasum -a 256"
fi

if [ -f "$RECEIPT_FILE" ] && [ -n "$HASH_CMD" ]; then
  LAST_STATE="$(cat "$RECEIPT_FILE" 2>/dev/null)"
  TREE_HASH="$(git rev-parse HEAD 2>/dev/null || echo "no-head")"
  STATUS_HASH="$(git status --porcelain | $HASH_CMD | awk '{print $1}')"
  CURRENT_STATE="${TREE_HASH}:${STATUS_HASH}"

  if [ -n "$CURRENT_STATE" ] && [ "$LAST_STATE" = "$CURRENT_STATE" ]; then
    SHORT_HEAD="$(git rev-parse --short HEAD 2>/dev/null || echo "HEAD")"
    echo "⚡ Local validation already passed for ${SHORT_HEAD}. Skipping duplicate tests!"
    exit 0
  fi
fi

echo "🚀 Running local validation before pushing (Skipping Playwright E2E & SBOM)..."
"$REPO_ROOT/infra/scripts/validate_local.sh" --fast
