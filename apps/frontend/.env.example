# ------------------------------------------------------------------------------
# CricScore Frontend Environment Template
# Copy this file to `apps/frontend/.env` and replace the values.
# WARNING: Do NOT commit `apps/frontend/.env` to version control.
# ------------------------------------------------------------------------------

# ==============================================================================
# SECTION A: USER CONFIGURATION (YOU MUST FILL THESE OUT)
# ==============================================================================

# (Optional) Sentry Crash Reporting Data Source Name
VITE_SENTRY_DSN=


# ==============================================================================
# SECTION B: AUTO-GENERATED CONFIGURATION (DO NOT MODIFY)
# ==============================================================================
# The deployment scripts will automatically append these variables.
# Leave them blank.
# ------------------------------------------------------------------------------

# AWS API Gateway URLs
VITE_API_URL=https://dummy-api-id.execute-api.us-east-1.amazonaws.com
VITE_WS_URL=wss://dummy-ws-id.execute-api.us-east-1.amazonaws.com/prod

# AWS Cognito Configuration
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
